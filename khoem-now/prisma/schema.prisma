// =============================================================
// KSV - Prisma Schema (MongoDB)
// Location: khoem-now/prisma/schema.prisma
//
// Per KSV Database Architecture (section 36): data is split by domain,
// not dumped into one giant table. Credentials/secrets are never stored
// as plain text (see encryption.util.ts for hashing/encryption).
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY & ACCOUNT
// ============================================================

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  passwordHash  String // NEVER plain text - see encryption.util.ts hashPassword()
  role          String // Owner | SuperAdmin | OrgAdmin | Manager | Operator | Controller | Viewer | Guest
  firstName     String?
  lastName      String?
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  sessions Session[]
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique // store a HASH of the token, not the raw value
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
}

// ============================================================
// ORGANIZATION & ENTERPRISE
// ============================================================

model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  ownerId   String   @db.ObjectId
  country   String? // ISO country code, per Internationalization system
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  devices Device[]
  sites   Site[]
}

model Site {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // e.g. "Frankfurt HQ", "Taipei Fab"
  address        String?
  createdAt      DateTime     @default(now())

  devices Device[]
}

// ============================================================
// DEVICE INTELLIGENCE
// ============================================================

model Device {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  deviceCode     String    @unique // e.g. "DEV-04821"
  type           String // door | hvac | vehicle | industrial | sensor | ...
  status         String    @default("offline") // online | offline | warning | maintenance
  organizationId String    @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  siteId         String?   @db.ObjectId
  site           Site?     @relation(fields: [siteId], references: [id])
  gatewayId      String?   @db.ObjectId
  protocolId     String?   @db.ObjectId
  firmwareVersion String?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commands    Command[]
  logs        DeviceLog[]
  discoveries Discovery[]
  safetyLogs  SafetyLog[]
}

model Discovery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId   String   @db.ObjectId
  device     Device   @relation(fields: [deviceId], references: [id])
  method     String // bluetooth | wifi | qr | nfc | cloud
  ipAddress  String?
  macAddress String?
  createdAt  DateTime @default(now())
}

// ============================================================
// COMMAND & AUTOMATION
// ============================================================

model Command {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  deviceId   String    @db.ObjectId
  device     Device    @relation(fields: [deviceId], references: [id])
  userId     String?   @db.ObjectId // null if triggered by automation/safety-engine
  type       String // e.g. "UNLOCK", "SETPOINT", "SPEED_LIMIT"
  payload    Json?
  status     String    @default("pending") // pending | success | failed | blocked
  response   Json?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  completedAt DateTime?
}

model AutomationRule {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String
  trigger        Json // e.g. { type: "time", value: "18:00" }
  action         Json // e.g. { deviceId, commandType, payload }
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ============================================================
// CONNECTIVITY & PROTOCOLS
// ============================================================

model Gateway {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // e.g. "Frankfurt Edge Controller"
  ipAddress String
  status    String   @default("offline")
  cpuUsage  Float?
  memUsage  Float?
  deviceCount Int    @default(0)
  version   String?
  lastPingAt DateTime?
  createdAt DateTime @default(now())
}

model Protocol {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  name         String // Bluetooth LE | Wi-Fi 6 | MQTT | Infrared | Zigbee
  code         String @unique // PROTO_BLE, PROTO_WIFI, PROTO_MQTT...
  securityType String? // AES-CCM | WPA3-Enterprise | TLS 1.3 | AES-128
  config       Json?
}

// ============================================================
// SAFETY & SECURITY
// ============================================================

model SafetyRule {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String // e.g. "Robot Speed Limit in Human Zone"
  category       String // door | vehicle | industrial
  severity       String // low | medium | high | critical
  triggerCount   Int      @default(0)
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model SafetyLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId  String   @db.ObjectId
  device    Device   @relation(fields: [deviceId], references: [id])
  eventType String
  severity  String
  message   String
  createdAt DateTime @default(now())
}

// ============================================================
// MONITORING / EVENTS
// ============================================================

model DeviceLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  deviceId  String   @db.ObjectId
  device    Device   @relation(fields: [deviceId], references: [id])
  data      Json
  createdAt DateTime @default(now())
}

model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  source    String
  payload   Json
  createdAt DateTime @default(now())
}

// ============================================================
// AUDIT (used by audit.log.ts - append-only, never updated/deleted)
// ============================================================

model AuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?  @db.ObjectId
  action         String // e.g. "device:command", "auth:login"
  deviceId       String?  @db.ObjectId
  organizationId String?  @db.ObjectId
  result         String // SUCCESS | FAILURE | BLOCKED
  ip             String?
  userAgent      String?
  reason         String?
  details        String? // JSON-stringified, sanitized (secrets redacted)
  createdAt      DateTime @default(now())
}

// ============================================================
// INTERNATIONALIZATION
// ============================================================

model Country {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  code     String @unique // ISO 3166-1 alpha-2, e.g. "KH", "DE"
  name     String
  timezone String?
}

model Language {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String @unique // ISO 639-1, e.g. "km", "en"
  name String
}
