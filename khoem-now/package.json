{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "guide:devices": "node scripts/generate-device-guide.ts",
    "test:adapters": "node --test src/core/protocol/adapters/adapters.test.ts",
    "test:catalog": "node --test src/core/devices/device.catalog.test.ts",
    "test:panel": "node --test src/components/catalogPanel.logic.test.ts",
    "dev": "vite",
    "server": "node --env-file=.env --experimental-strip-types src/server.ts",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run test:adapters && npm run test:catalog && npm run test:panel",
    "validate:locales": "node scripts/i18n-audit.mjs",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "report:translations": "node scripts/i18n-audit.mjs || true",
    "verify": "npm run typecheck && npm run validate:locales && npm run check:duplicates && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@supabase/supabase-js": "^2.57.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.446.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "mqtt": "^5.16.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
